"""Internal native execution API; Python owns scheduling and result publication."""
from collections.abc import Awaitable, Mapping, Sequence
from typing import Any
from perf_benchmark.runtime.http.native_result import NativeResult as NativeResult

class PreparedBody:
    def __init__(self, segments: Sequence[bytes | memoryview], length: int) -> None: ...
    def release(self) -> None: ...

class NativeTrial:
    def submit(self, body: PreparedBody, command: Mapping[str, Any], *, cancelled: bool = False) -> Attempt: ...
    @property
    def active_count(self) -> int: ...
    @property
    def closed(self) -> bool: ...
    @property
    def finished(self) -> bool: ...
    def close_session(self, session_id: str) -> Awaitable[None]: ...
    def close(self) -> Awaitable[None]: ...

class Attempt:
    def cancel(self) -> None: ...
    @property
    def settled_done(self) -> bool: ...
    def started(self) -> Awaitable[int | None]: ...
    def result(self) -> Awaitable[NativeResult]: ...
    def settled(self) -> Awaitable[None]: ...
    @property
    def id(self) -> int: ...

class TraceHashInflator:
    def __init__(self, tokenizer_path: str, tokenizer_config_path: str, block_size: int,
                 workers: int, queue_capacity: int, cache_max_bytes: int) -> None: ...
    def inflate(self, length: int, hash_ids: list[int]) -> str: ...
    def reset_scope(self) -> None: ...
    def stats(self) -> tuple[int, int, int, int]: ...
    def close(self) -> None: ...

def now() -> int: ...
def create_trial(protocol: str) -> NativeTrial: ...

class OutputSamples:
    def __new__(cls, data: bytes) -> OutputSamples: ...
    def __len__(self) -> int: ...
    def __getitem__(self, key: int | slice) -> tuple[int, int, int] | tuple[tuple[int, int, int], ...]: ...
