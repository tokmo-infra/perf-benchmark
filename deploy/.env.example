# Copy to deploy/.env. Both Docker entry scripts source this trusted shell file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD='replace-with-a-long-random-password'
OBSERVATION_IMAGE=perf-observation:local
OBSERVATION_BIND_IP=0.0.0.0
OBSERVATION_NETWORK=perf-observation
PERF_BENCHMARK_IMAGE=perf-benchmark:local
# One browser origin for the workbench and embedded Grafana; root path only.
# For an HTTPS reverse proxy, use its origin and preserve / and /grafana/ routes.
WORKBENCH_PORT=8088
WORKBENCH_PUBLIC_URL=http://127.0.0.1:8088
# Optional explicit Go module proxy during image build; no automatic mirror fallback.
GO_MODULE_PROXY=https://proxy.golang.org

# Optional absolute host directories. Defaults: deploy/benchmark/config, deploy/data, deploy/tokenizer.
# BENCHMARK_CONFIG=/absolute/path/to/configs
# BENCHMARK_DATA=/absolute/path/to/data
# BENCHMARK_TOKENIZER=/absolute/path/to/tokenizer
# PERF_TARGET_API_KEY=...  # Prefer existing process/secret injection.
